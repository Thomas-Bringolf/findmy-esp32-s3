# Copy to .env and adjust. The compose file reads these.
# Absolute path to the toolbox live state (account_state.json + devices.json).
ESP32_TRACKER_DIR=/home/thomas/Projects/ESP32-tracker/Scripts/state

# How often the backend fetches from Apple (seconds).
FETCH_INTERVAL=900
BACKTRACK=180
VERBOSE=0

# Host port for the web UI.
WEB_PORT=8080
