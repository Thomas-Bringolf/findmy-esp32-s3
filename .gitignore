# ------------------------------------------------------------------
# Scripts/state/ — NEVER commit this folder.
# It holds the Apple ID + password + anisette session, the per-device
# private keys (master_key / skn) and every retrieved GPS coordinate.
# The real directory is replaced by state_example/ in the repository.
# ------------------------------------------------------------------
Scripts/state/

# Python
__pycache__/
*.py[cod]

# ESP-IDF build artefacts (regenerate with `idf.py build`)
ESP32/build/
ESP32/venv/
ESP32/.cache/
ESP32/sdkconfig.old

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# daemon build artefact (regenerate with `make` in daemon/)
daemon/findmy-os-daemon
daemon/findmy-os-daemon.log

# ------------------------------------------------------------------
# dashboard/ — secrets and generated files must NOT be committed.
# config.js holds the Carto map API key; keep the committed
# config.example.js as the template instead.
# ------------------------------------------------------------------
dashboard/web/config.js
dashboard/.env
dashboard/backend/__pycache__/
docker-compose.yml
